# Keep EAS uploads aligned with the repository's root ignore rules.
node_modules
.next
out
.env.local
.env*.local
*.tsbuildinfo
.vercel
.DS_Store
*.log
model/data/*.json
model/artifacts/*.json
playwright-report
test-results
backups/
__pycache__/
*.py[cod]

# Native projects and caches are generated by Expo CNG in the cloud.
/apps/mobile/android
/apps/mobile/ios
/apps/mobile/.expo
/apps/mobile/.npm-cache
/apps/mobile/dist
/apps/mobile/web-build

# Local diagnostic output is never needed by EAS Build.
/tmp
/.git
/supabase/.temp
