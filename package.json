{
  "name": "thursday-league",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude=e2e/**",
    "test:model": "python -m unittest discover -s model/tests",
    "test:db": "node scripts/test-database.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:backup": "node scripts/backup-supabase.mjs",
    "db:backup:verify": "node scripts/verify-supabase-backup.mjs",
    "storage:backup": "node scripts/backup-supabase-storage.mjs",
    "storage:backup:verify": "node scripts/verify-supabase-backup.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.22",
    "postcss": "^8.4.45",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  }
}
