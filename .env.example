NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional override for the public address shown on store support/privacy pages.
NEXT_PUBLIC_SUPPORT_EMAIL=thursdayleagueapp@gmail.com

# Native verified links. Add these in Vercel before store beta builds.
# Apple provides the Team ID with a paid Apple Developer membership.
APPLE_TEAM_ID=YOUR_10_CHARACTER_APPLE_TEAM_ID
# Comma-separated SHA-256 app-signing certificate fingerprints from EAS/Play Console.
ANDROID_APP_CERT_SHA256=AA:BB:CC:DD:EE:FF
